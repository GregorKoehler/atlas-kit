# Copy to ".env" at the repo root and fill in. NEVER commit the real .env.
# Everything with a sensible default is optional; the REQUIRED ones are marked.

# --- The vault (your knowledge base) -------------------------------------
# Absolute path on the box to your Atlas vault — a git checkout of your repo
# created from the llm-atlas template (https://github.com/GregorKoehler/llm-atlas).
# The dashboard reads Wiki/ + Tasks/ from here; agents commit back into it.  REQUIRED.
VAULT_PATH=/vault

# --- App-layer auth ------------------------------------------------------
# Shared bearer for every write/exec route. Generate a long random value:
#   openssl rand -hex 32
# In production Caddy injects it server-side so the browser never holds it.  REQUIRED.
DASHBOARD_BEARER_TOKEN=

# --- Express API ---------------------------------------------------------
API_PORT=3001                 # Express listens here (127.0.0.1 only; fronted by /api proxy)
API_HOST=127.0.0.1

# --- MCP server (the vault as a Claude connector) ------------------------
MCP_PORT=3002
MCP_BIND=127.0.0.1
# Cloudflare Access (Managed OAuth) for the REMOTE MCP connector. Leave BOTH
# blank ONLY while the endpoint is loopback-only and no tunnel ingress routes
# MCP_PORT. Fill once the Access app exists (see docs/SETUP.md).
# ⚠️ FAILS CLOSED: if the endpoint is reachable (a non-loopback MCP_BIND, or a
# cloudflared ingress rule for MCP_PORT) while either of these is blank, the MCP
# server REFUSES TO START and says why. A blank value counts as unset, so you
# cannot silently reopen the endpoint by emptying one.
CF_ACCESS_TEAM_DOMAIN=        # e.g. yourteam.cloudflareaccess.com
CF_ACCESS_AUD=               # the Access application's AUD tag
# The HTTP MCP endpoint serves the 7 knowledge READ tools and nothing else.
# ATLAS_MCP_HTTP_SURFACE=broad widens it to the full NON-CONTROL tool set; the
# agent-control tools (spawn/steer/ship/merge/kill) are never served here either way.
# ATLAS_MCP_HTTP_SURFACE=knowledge

# --- Agent steering / delivery -------------------------------------------
# Queued messages meant to change an agent's course (an operator prompt, an
# orchestrator steer, a reply receipt) are delivered at the running turn's next
# TOOL-CALL BOUNDARY; observational ones still wait for a full idle. Set to 0 to
# restore idle-only delivery everywhere. The bridge has its own switch, since a
# bridge machine restarts separately from the box.
# AGENT_BOUNDARY_DELIVERY=1
# BRIDGE_BOUNDARY_DELIVERY=1
# Max chars in a single delivered prompt (both executors).
# AGENT_PROMPT_MAX_CHARS=50000

# --- Box-local dev/knowledge agents (git worktree + tmux + claude CLI) ----
# WORKSPACE_DIR   default repo path for a box-local dev-agent repo whose entry
#                 in agent-local-repos.json omits `path` (default /workspace).
# AGENT_LOCAL_DIR state dir for worktrees, registry, audit log (default ~/.atlas-kit).
# WORKSPACE_DIR=/workspace
# AGENT_LOCAL_DIR=/root/.atlas-kit
# AGENT_LOCAL_MAX_CONCURRENT=4          # cap live box-local agents (RAM guard)
# AGENT_TITLE_MODEL=claude-haiku-4-5    # tiny claude -p that titles a new agent

# --- Atlas evidence at spawn (retrieval, not a briefing turn) -------------
# Every dev agent and every Atlas chat opens with a retrieved candidate set from
# the vault (docs/PROTOCOLS.md §4). Defaults are the shipped behaviour; each knob
# falls back to its default on a blank or unparseable value.
# ATLAS_EVIDENCE_BYTES=33000            # total injected evidence, bytes
# ATLAS_EVIDENCE_DONE_WEIGHT=0.6        # toll on closed `status: done` tasks in the
#                                       # prose ranking: they are DEMOTED, not hidden,
#                                       # and survivors are labelled `· ✓done`.
#                                       # 0 = exclude them (stated in the block), 1 = no toll
# ATLAS_EVIDENCE_SEMANTIC=1             # turn on the dense/vector leg — needs the
#                                       # optional semantic-search addon; off by default
# Section cuts — experiments, off by default (see atlas-candidates.mjs):
# ATLAS_EVIDENCE_DROP_LOG=1             # drop the keyword-scored Wiki/log.md section
# ATLAS_EVIDENCE_INDEX_LINES=26         # Wiki/index.md catalog lines
# ATLAS_EVIDENCE_LEX_PAGES=12           # full-text pages EXCERPTED
# ATLAS_EVIDENCE_LEX_LINES=24           # …plus this many named-only in the tail

# --- Vault commit identity (agents + Kanban commits) ---------------------
# The name/email stamped on commits the API makes to your vault.
ATLAS_AUTHOR_NAME=Atlas Kit
ATLAS_AUTHOR_EMAIL=atlas-kit@localhost
ATLAS_BRANCH=main

# --- Remote dev agents via a workstation bridge (optional) ----------------
# Leave AGENT_BRIDGE_URL blank and the remote-spawn path just shows "offline".
# The bridge runs on another machine on your Tailscale tailnet (see agent-bridge/).
AGENT_BRIDGE_URL=            # e.g. http://100.x.y.z:7878 (the workstation's tailnet IP)
AGENT_BRIDGE_TOKEN=         # MUST match BRIDGE_TOKEN in agent-bridge/bridge.env
AGENT_WORKSTATION_LABEL=workstation
AGENT_BRIDGE_REPOS=         # comma list of repo keys this bridge advertises as spawnable
AGENT_BRIDGE_MAX_AGENTS=    # optional ceiling for this catch-all bridge, overriding what it reports on /health

# --- Bridge polling resilience -------------------------------------------
# A bridge that answers late must not blank the agent surfaces, and a bridge
# that stops answering must not read as "no agents" (the last roster it DID
# answer with is remembered and drawn as stale — see api/src/bridge-roster.mjs).
AGENT_BRIDGE_TIMEOUT_MS=8000        # GET /sessions timeout — short, so the card shows "offline" fast
AGENT_BRIDGE_EXEC_TIMEOUT_MS=30000  # spawn/prompt/kill timeout — long, `git worktree add` can be slow
AGENT_BRIDGE_STALE_FAILURES=2       # consecutive failed polls tolerated (serving the last-known-good sessions) before a bridge flips to unreachable
AGENT_BRIDGE_STALE_MAX_MS=60000     # ...or this long since the last successful poll, whichever comes first
# AGENT_BRIDGE_ROSTER_PERSIST_MS=30000  # how often an unchanged roster is re-persisted
# AGENT_BRIDGE_FETCH_TTL_MS=30000       # how long a bridge's "behind by N commits" count is cached
# AGENT_REMOTE_REAP_GRACE_MS=60000      # a remote agent must be absent this long before its session is closed
# AGENT_PHASE_ANCHOR_MAX_AGE_MS=60000   # a first-observed phase anchors at spawn only while the spawn is this fresh
# AGENT_RUN_MAX_MS=14400000             # backstop ceiling on one recorded run (clamped + flagged past it)

# --- Agent↔agent message bus + remote Atlas queries -----------------------
# Peer mail between agents in one lineage (`agent-msg <id> "<text>"`), and the
# read-only `atlas-query` remote agents get relayed over the same bridge channel.
# AGENT_MESSAGE_PAIR_MAX=12           # messages one agent may send another per window
# AGENT_MESSAGE_PAIR_WINDOW_MS=1800000
# ATLAS_QUERY_MAX=40                  # Atlas queries one remote agent may run per window
# ATLAS_QUERY_WINDOW_MS=1800000
# ATLAS_QUERY_RESULT_MAX=20000        # hard cap on an answer travelling back through the relay
# ATLAS_QUERY_VAULT=atlas             # which vault an unqualified `atlas-query` reads

# --- Task prospects -------------------------------------------------------
# Agent-proposed tasks wait here until you approve them; the store lives OUTSIDE
# the vault, so a rejected prospect never touches it.
# ATLAS_PROSPECTS_FILE=               # default: api/.state/atlas-prospects.json
