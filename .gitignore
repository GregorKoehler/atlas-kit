.env
node_modules
web/dist/
api/.state/
# Operator-local config (see the *.example.json templates):
#   which optional addons this box runs (ATLAS_ADDONS overrides it)
addons.json
#   which repos a box-local dev agent may spawn on (the spawn boundary)
api/src/agent-local-repos.json
#   extra remote agent bridges (multi-bridge routing)
api/src/bridges.json
#   multi-vault registry (a single VAULT_PATH works without this file)
api/src/vaults.json
#   model-provider profiles — HOLDS YOUR API KEYS (docs/PROVIDERS.md)
api/src/providers.json
#   the instagram-ingest skill link, created by that addon's install.sh
.claude/skills/instagram-ingest
#   YOUR feed list for the news-ingest addon (feeds.example.json is what ships)
addons/news-ingest/feeds.json
#   the news-ingest skill link, created by that addon's install.sh
.claude/skills/news-ingest
# agent-bridge operator-local config
agent-bridge/repos.json
agent-bridge/bridge.env
