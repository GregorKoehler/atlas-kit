# Atlas Kit reverse proxy. Copy to infra/Caddyfile and adjust <REPO_ROOT>.
# serve.sh runs `caddy run --config infra/Caddyfile` (with .env sourced, so
# {env.DASHBOARD_BEARER_TOKEN} is available). Binds :8080 on localhost; a
# Cloudflare Tunnel + Access front it at the edge (see docs/SETUP.md).
#
# The pattern: WRITE/EXEC routes get the bearer injected here server-side, so the
# browser never holds the token. READ routes and the live-app proxy pass through
# untouched (Cloudflare Access gates identity at the edge).

:8080 {
	encode gzip

	# --- Write/exec routes: inject the dashboard bearer, then proxy to Express ---
	handle /api/agents/* {
		reverse_proxy localhost:3001 {
			header_up Authorization "Bearer {env.DASHBOARD_BEARER_TOKEN}"
		}
	}
	handle /api/tasks/* {
		reverse_proxy localhost:3001 {
			header_up Authorization "Bearer {env.DASHBOARD_BEARER_TOKEN}"
		}
	}
	handle /api/atlas/* {
		reverse_proxy localhost:3001 {
			header_up Authorization "Bearer {env.DASHBOARD_BEARER_TOKEN}"
		}
	}
	# Task Prospects: /new, /approve and /reject are bearer-gated writes, so the
	# review card's Approve/Reject buttons need the token injected here. (Bare
	# GET /api/prospects — the pending queue — is an open read and falls through
	# to the read handler below, like every other GET.)
	handle /api/prospects/* {
		reverse_proxy localhost:3001 {
			header_up Authorization "Bearer {env.DASHBOARD_BEARER_TOKEN}"
		}
	}
	# Redeploy button on a `self_deploy: true` project card: POST /api/deploy is a
	# bearer-gated exec route. (GET /api/deploy/status is an open read and matches
	# this same handler — the token is harmless on it.)
	handle /api/deploy* {
		reverse_proxy localhost:3001 {
			header_up Authorization "Bearer {env.DASHBOARD_BEARER_TOKEN}"
		}
	}
	# (The token is harmless on the read routes below; only writes require it.)

	# --- Optional addons: their write routes need the same injection -----------
	# Addon routers are mounted WITHOUT core's bearer middleware, so each addon
	# gates its own writes with the same DASHBOARD_BEARER_TOKEN check — which
	# means the browser can only reach them through a handler here, exactly like
	# a core write (docs/ADDONS.md, "routes"). These blocks are inert on a box
	# where the addon is not enabled: the path simply 404s from Express.
	# `api/test/addon-caddyfile-bearer.test.mjs` fails if a shipped addon
	# registers a non-GET route that no block above matches first.
	# news-ingest: POST /api/news/sweep. (Bare GET /api/news — the headlines the
	# News card reads — does not match `/api/news/*` and falls through below.)
	handle /api/news/* {
		reverse_proxy localhost:3001 {
			header_up Authorization "Bearer {env.DASHBOARD_BEARER_TOKEN}"
		}
	}
	# instagram-ingest: POST /api/ingest/instagram. (GET /api/ingest/instagram/records
	# is an open read and matches this same handler — the token is harmless on it.)
	handle /api/ingest/* {
		reverse_proxy localhost:3001 {
			header_up Authorization "Bearer {env.DASHBOARD_BEARER_TOKEN}"
		}
	}
	# voice: POST /api/voice/recap, /speak and /transcribe — each spends a model
	# call or on-box CPU. Without this, the card degrades to the free browser
	# path rather than failing (addons/voice/README.md).
	handle /api/voice/* {
		reverse_proxy localhost:3001 {
			header_up Authorization "Bearer {env.DASHBOARD_BEARER_TOKEN}"
		}
	}

	# --- Read routes (open; Cloudflare Access gates them at the edge) ---
	handle /api/* {
		reverse_proxy localhost:3001
	}

	# --- Dev-agent live-app preview (HTTP + auto-upgraded WebSocket) ---
	handle /agent-app/* {
		reverse_proxy localhost:3001
	}

	# --- Static SPA (the built dashboard) with PWA-safe caching ---
	@assets path /assets/*
	handle {
		root * <REPO_ROOT>/web/dist
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# --- Hardening headers ---
	# X-Frame-Options is SAMEORIGIN (not DENY) so the dashboard can iframe its own
	# /agent-app/* live-app proxy.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy no-referrer
	}
}
